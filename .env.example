# Copy this file to .env for local development. On Render, set these as
# real environment variables in the service dashboard instead — .env is
# never read there.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-secret-key

# "True" for local development, "False" in production.
DEBUG=True

# Comma-separated list of hostnames Django will serve.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of origins allowed to POST (needed for HTTPS domains).
# Example: CSRF_TRUSTED_ORIGINS=https://resumatch.onrender.com
CSRF_TRUSTED_ORIGINS=

# Postgres connection string. Leave unset locally to use SQLite instead.
# Example: DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
